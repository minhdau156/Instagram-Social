# Copy to .env and fill in. Never commit .env.

# Domain (A record -> Elastic IP)
DOMAIN=example.com

# Postgres
DATABASE_PASSWORD=change-me

# MinIO
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-min-8-chars

# JWT (RSA keys, base64 or PEM as the backend expects)
JWT_RSA_PRIVATE_KEY=
JWT_RSA_PUBLIC_KEY=

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Grafana Cloud
# One API key is the password for Mimir, Loki and Tempo.
GC_API_KEY=
GC_PROM_URL=
GC_PROM_USER=
# Logs (Loki)
GC_LOKI_URL=
# Traces (Tempo OTLP)
GC_TEMPO_OTLP_ENDPOINT=
# base64("<tempo-user>:<GC_API_KEY>")
GC_BASIC_AUTH_B64=